  "reserved_system_policy": "W&B System is SDK hardware telemetry only (CPU/GPU/RAM). Custom sampling/inference/update metrics use train/performance_*. Active V7 is unchanged.",
  "stages": {
    "train": "training; optimization, progress and custom performance also belong here",
    "val": "validation; core/reward have their own flat sections; greedy_ stays inside each section",
    "test": "independent heldout; checkpoint and sampled/greedy follow the family prefix; never selection"
  },
  "variant_prefixes": {
    "train": [
      ""
    ],
    "val": [
      "",
      "greedy_"
    ],
    "test": [
      "{initial|best|final}_{sampled|greedy}_"
    ]
  },
  "panel_sections": {
    "train_core": "training core performance only",
    "train_reward": "all training reward amounts, subtotals and total",
    "train": "other training metrics: operation, optimization, progress and performance",
    "val_core": "stochastic and greedy validation core performance; greedy_ prefixes greedy fields",
    "val_reward": "all stochastic and greedy validation reward amounts; greedy_ prefixes greedy fields",
    "val": "other stochastic and greedy validation metrics, with family_greedy_ for greedy fields",
    "test": "all initial/best/final sampled/greedy heldout metrics, preserving family_checkpoint_mode_ prefixes"
  },
  "section_routing": {
    "train": {
      "core": "train_core",
      "reward": "train_reward",
      "default": "train"
    },
    "val": {
      "core": "val_core",
      "reward": "val_reward",
      "default": "val"
    },
    "test": {
      "default": "test"
    }
  },
  "field_naming": {
    "train_core|train_reward": "{metric}",
    "val_core|val_reward": "{variant_prefix}{metric}",
    "train|val": "{family}_{variant_prefix}{metric}",
    "test": "{family}_{checkpoint}_{mode}_{metric}"
  },
